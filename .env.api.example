# Copy to .env.api and replace these values. Never commit .env.api.
ASPNETCORE_ENVIRONMENT=Production
PublicOrigin=https://foodies.example.com
# Keep loopback hosts so the container health check can reach the API.
AllowedHosts=foodies.example.com;localhost;127.0.0.1;api
# localhost inside a container points to that container. For SQL on Docker Desktop's host:
# Server=host.docker.internal,1433;Database=Foodies;User ID=REEMPLAZAR;Password=REEMPLAZAR;Encrypt=True;TrustServerCertificate=False;
ConnectionStrings__Foodies=
Google__ClientId=
Google__ClientSecret=
Sms__Enabled=false
Sms__Endpoint=https://api.sms-gate.app/3rdparty/v1/messages
Sms__Username=
Sms__Password=
DevelopmentAccess__Enabled=false
PhoneVerification__AllowUnverifiedOrders=false
Media__StoragePath=/data/foodies/media
DataProtection__KeyPath=/data/foodies/keys
